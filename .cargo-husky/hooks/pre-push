#!/bin/sh
set -e

if ! command -v linecheck >/dev/null 2>&1; then
  echo "linecheck is not installed. Install it with: cargo install linecheck --locked" >&2
  exit 1
fi
linecheck .

cargo test
cargo-machete
cargo clippy --workspace --all-targets --locked -- -D warnings

# Enforce 100% line coverage on pure-logic modules (hardware/UI code excluded).
# Uses cargo-llvm-cov; install with: cargo install cargo-llvm-cov
# bin/ is the egui editor (UI code, no unit coverage target).
IGNORE="main\.rs|logging\.rs|controller/(run|tick|input|setup|side|reload|ctx|mod)\.rs|usb/|images/|application/|tui/mod|tui/render|presentation/mod|persistence|bin/|infrastructure/frontmost/os\.rs|infrastructure/app_icon/os\.rs$|infrastructure/app_icon/icns_render\.rs$|infrastructure/claude_sessions/os\.rs$|infrastructure/claude_sessions/os/terminal\.rs$|infrastructure/claude_sessions/os/summary\.rs$|infrastructure/claude_sessions/os/tty_age\.rs$|infrastructure/process/os\.rs$|infrastructure/focused_session/os\.rs$|infrastructure/system_metrics/os\.rs$|infrastructure/moadim/os\.rs$|infrastructure/keyboard/os|(^|/)apps/"
cargo llvm-cov \
  --ignore-filename-regex "$IGNORE" \
  --fail-under-lines 100
