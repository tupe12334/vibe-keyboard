<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  LaunchAgent for the headless controller. Rendered by
  packaging/macos/build-app.sh --install, which replaces @HOME@ with $HOME.
  Runs as the logged-in user (gui domain). No root, no sudo.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.tupe12334.vibe-keyboard.controller</string>
    <key>ProgramArguments</key>
    <array>
        <string>@HOME@/Applications/VibeKeyboard.app/Contents/MacOS/listen</string>
        <string>--headless</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <dict>
        <!-- Restart after a crash; do not restart after a clean exit. -->
        <key>SuccessfulExit</key>
        <false/>
    </dict>
    <key>StandardOutPath</key>
    <string>@HOME@/Library/Logs/vibe-keyboard/controller.log</string>
    <key>StandardErrorPath</key>
    <string>@HOME@/Library/Logs/vibe-keyboard/controller.log</string>
</dict>
</plist>
